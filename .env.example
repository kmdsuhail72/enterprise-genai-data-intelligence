# ===========================================
# Enterprise GenAI Data Intelligence Platform
# Environment Configuration
# ===========================================
# Copy this file to .env and update values for your environment.
# NEVER commit the .env file to version control.

# --- Application ---
APP_NAME=Enterprise GenAI Data Intelligence Platform
APP_ENV=development                           # development | staging | production
APP_DEBUG=true                                # Enable debug mode (disable in production)
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=DEBUG                           # DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_SECRET_KEY=

# --- Database (PostgreSQL + pgvector) ---
# Set DATABASE_URL to override the fields below, for example:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
# Keep real credentials in .env or your deployment secret store, never here.
DB_HOST=localhost
DB_PORT=5433
DB_USER=genai_user
DB_PASSWORD=
DB_NAME=genai_platform
DB_POOL_SIZE=5                                # Connection pool size
DB_MAX_OVERFLOW=10                            # Max overflow connections beyond pool size
# DB_SSL_MODE=prefer                          # disable | allow | prefer | require | verify-ca | verify-full

# Optional pgAdmin profile: set both values before starting with --profile admin.
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# --- Storage ---
STORAGE_BACKEND=local                         # local | s3
STORAGE_LOCAL_PATH=./data/uploads             # Local filesystem path for uploads

# S3 Configuration (for AWS / S3-compatible deployment)
# AWS credentials should be supplied through AWS_PROFILE, an IAM role, or a
# secret manager. Avoid placing access keys in this file.
AWS_S3_BUCKET=
AWS_REGION=us-east-1
# AWS_S3_PREFIX=uploads/

# --- LLM Providers ---
LLM_PROVIDER=ollama                           # ollama | openai | google | bedrock

# Ollama (local, default for development)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:1b

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_ORG_ID=

# Google Gemini
# GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-1.5-pro

# AWS Bedrock
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BEDROCK_REGION=us-east-1
# AWS_BEDROCK_MODEL=anthropic.claude-3-sonnet

# --- Embeddings ---
EMBEDDING_PROVIDER=ollama                     # ollama | openai | google
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768                       # Must match the chosen embedding model

# --- RAG Pipeline ---
RAG_CHUNK_SIZE=1000                           # Characters per text chunk
RAG_CHUNK_OVERLAP=200                         # Overlap between consecutive chunks
RAG_TOP_K=10                                  # Number of candidate chunks to retrieve
RAG_RERANK_TOP_N=5                            # Number of chunks after reranking

# --- Authentication / JWT ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- PII Detection & Masking ---
PII_DETECTION_ENABLED=true                    # Enable PII detection in uploaded documents
PII_MASKING_ENABLED=true                      # Automatically mask detected PII

# --- Rate Limiting ---
# RATE_LIMIT_REQUESTS_PER_MINUTE=60           # API rate limit per user
# RATE_LIMIT_BURST=10                         # Burst allowance

# --- CORS (comma-separated origins) ---
# CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# --- Redis (optional, for caching / task queue) ---
# REDIS_URL=redis://localhost:6379/0
